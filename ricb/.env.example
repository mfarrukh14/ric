# Copy to .env and fill in. Never commit .env.

# Server
HOST=0.0.0.0
PORT=5000
# Comma-separated browser origins allowed to call the API (empty = any)
CORS_ORIGINS=

# Auth - use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
# Optional key for the encrypted staff passwords shown in People & teams (defaults to one
# derived from JWT_SECRET). Changing it makes stored passwords unreadable until reset.
CREDENTIALS_KEY=

# Database: auto (SQL Server if reachable at startup, else the local SQLite file),
# mssql (SQL Server only) or sqlite (local file only)
DB_CLIENT=auto
SQLITE_FILE=database.sqlite

# Main eProc database (SQL Server)
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=

# HMS inventory database (read-only stock lookups during store fulfillment)
HMS_STOCK_DB_HOST=
HMS_STOCK_DB_PORT=1433
HMS_STOCK_DB_NAME=
HMS_STOCK_DB_USER=
HMS_STOCK_DB_PASSWORD=

# Outgoing email (Gmail app password)
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=RIC E-Tender System
EMAIL_FROM_EMAIL=
# true = log emails instead of sending them (local testing)
EMAIL_DISABLED=false

# Finance module integration: shared secret sent as the X-Finance-Token header
FINANCE_CALLBACK_TOKEN=
